META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_user_access_token
META_LOGIN_CONFIG_ID=your_login_configuration_id
META_API_VERSION=v21.0

# Database URL:
# Su Render.com o Neon.tech inserisci l'URI PostgreSQL: postgresql://user:password@host/dbname?sslmode=require
# In locale, se omesso, viene usato automaticamente SQLite locale (data/autosponsor.db)
DATABASE_URL=

# Chiave segreta per autorizzare il webhook di Cron esterno (es. cron-job.org o GitHub Actions)
# Endpoint: POST /api/cron/check-and-sponsor con header 'Authorization: Bearer your_secret_key'
CRON_SECRET=segreto_cron_sicuro_123456

# Fonti opzionali di fallback usate se non lette dal Business Manager
META_FACEBOOK_PAGES=PAR:102540839140284,PAA:865867900231234
META_INSTAGRAM_ACCOUNTS=PAA:17841407257789484,PAR:17841453220428095

# Token opzionali di pagina
META_PAGE_ACCESS_TOKEN_PAR=your_par_page_access_token
META_PAGE_ACCESS_TOKEN_PAA=your_paa_page_access_token
